{
  "hosting": {
    "public": ".output/public",
    "ignore": ["**/.!(well-known)", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "accelerometer=(self \"https://www.youtube-nocookie.com\"), autoplay=(self \"https://www.youtube-nocookie.com\"), camera=(), compute-pressure=(self \"https://www.youtube-nocookie.com\"), display-capture=(), encrypted-media=(self \"https://www.youtube-nocookie.com\"), fullscreen=(self \"https://www.youtube-nocookie.com\"), geolocation=(), gyroscope=(self \"https://www.youtube-nocookie.com\"), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self \"https://www.youtube-nocookie.com\"), usb=(), clipboard-write=(self \"https://www.youtube-nocookie.com\")"
          },
          {
            "key": "Content-Security-Policy",
            "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; img-src 'self' data: blob: https:; media-src 'self' data: blob:; font-src 'self' data: https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://esm.sh; connect-src 'self' https://formsubmit.co https://api.github.com https://*.githubusercontent.com https://esm.sh https://cdn.jsdelivr.net https://api.iconify.design; frame-src https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "X-Test",
            "value": "root"
          }
        ]
      },
      {
        "source": "**/",
        "headers": [
          {
            "key": "X-Test",
            "value": "dir"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "X-Test",
            "value": "html"
          }
        ]
      },
      {
        "source": "**/*.@(avif|webp|png|jpg|jpeg|gif|svg|ico|pdf|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "_nuxt/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/_payload.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "_ipx/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/open-source",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/open-source/",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/minis",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/minis/",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/portfolio-website",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/portfolio-website/",
        "destination": "/projects/",
        "type": 301
      }
    ],
    "rewrites": []
  },
  "emulators": {
    "hosting": {
      "port": 5009
    },
    "ui": {
      "enabled": false,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
