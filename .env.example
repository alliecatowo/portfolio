# Nuxt Studio — Self-Hosted Auth Provider
# Required for production Studio access at /_studio
# See: https://nuxt.studio/auth-providers

# GitHub OAuth (recommended)
# Create at: https://github.com/settings/applications/new
# Callback URL: https://allisons.dev/_studio/api/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# Alternative: GitLab OAuth
# STUDIO_GITLAB_CLIENT_ID=
# STUDIO_GITLAB_CLIENT_SECRET=

# Alternative: Google OAuth
# STUDIO_GOOGLE_CLIENT_ID=
# STUDIO_GOOGLE_CLIENT_SECRET=

# Studio base URL (optional — auto-detected on Vercel/Netlify/etc)
# NUXT_PUBLIC_STUDIO_URL=https://allisons.dev

# Nuxt Studio Git token (for committing content changes)
# Needs repo:write scope on the portfolio repo
# STUDIO_GITHUB_TOKEN=
