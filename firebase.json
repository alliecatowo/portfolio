{
  "hosting": {
    "public": ".output/public",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "_nuxt/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "_ipx/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/open-source",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/open-source/",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/minis",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/minis/",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/portfolio-website",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/portfolio-website/",
        "destination": "/projects/",
        "type": 301
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
