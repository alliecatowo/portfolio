{
  "functions": [
    {
      "source": ".output-studio/server",
      "codebase": "studio",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "hosting": {
    "public": ".output/public",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(avif|webp|png|jpg|jpeg|gif|svg|ico|pdf|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "_nuxt/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/_payload.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "_ipx/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/open-source",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/open-source/",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/minis",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/minis/",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/portfolio-website",
        "destination": "/projects/",
        "type": 301
      },
      {
        "source": "/projects/portfolio-website/",
        "destination": "/projects/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/_studio",
        "function": {
          "functionId": "studio",
          "region": "us-central1"
        }
      },
      {
        "source": "/__nuxt_studio/**",
        "function": {
          "functionId": "studio",
          "region": "us-central1"
        }
      },
      {
        "source": "/sw.js",
        "function": {
          "functionId": "studio",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001
    }
  }
}
