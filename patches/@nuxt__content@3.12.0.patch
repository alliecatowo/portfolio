+// allisons.dev patch: a logged-in Nuxt Studio user (studio-session-check cookie) loads the
+// draft-including dump from the Studio function (server/studio/drafts-dump.ts) instead of the
+// public, draft-free /__nuxt_content/<collection>/sql_dump.txt. Any failure falls back to the
+// public dump. The Studio dump is never written to localStorage, so drafts are never cached
+// under the public checksum keys. Re-check this patch on every @nuxt/content upgrade.
+async function loadStudioDump(collection) {
+  try {
+    const compressed = await $fetch(`/__nuxt_studio/content/${collection}/sql_dump.txt`, {
+      responseType: "text",
+      credentials: "same-origin",
+      cache: "no-store",
+      query: { t: Date.now() }
+    });
+    if (typeof compressed !== "string" || !compressed) {
+      return null;
+    }
+    return await decompressSQLDump(compressed);
+  } catch {
+    return null;
+  }
+}
