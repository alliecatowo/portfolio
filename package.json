{
  "name": "portfolio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "build": "nuxt build",
    "build:static": "nuxt generate",
    "build:studio": "NITRO_PRESET=firebase nuxt build && node scripts/prepare-studio-function.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare || true",
    "start": "node .output/server/index.mjs",
    "start:prod": "NODE_ENV=production node .output/server/index.mjs",
    "typecheck": "nuxi typecheck",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "validate:content": "node scripts/validate-content.ts",
    "test:webmcp": "node scripts/test-webmcp.mjs",
    "check:images": "node scripts/check-image-variants.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "lighthouse": "lhci autorun",
    "serve:static": "node scripts/serve-static.mjs",
    "measure:nav": "node scripts/measure-nav.mjs",
    "worktree": "node scripts/worktree.mjs",
    "pr:preview": "node scripts/pr-preview.mjs",
    "content:format": "node scripts/format-content.mjs",
    "content:format:check": "node scripts/format-content.mjs --check",
    "content:roundtrip": "node scripts/check-studio-roundtrip.mjs",
    "lockfile:check": "pnpm install --frozen-lockfile --prefer-offline",
    "lockfile:update": "pnpm install && git add pnpm-lock.yaml",
    "db:clean": "rm -rf .data/content/contents.sqlite",
    "db:rebuild": "pnpm db:clean && nuxt prepare",
    "dev:clean": "pnpm db:clean && pnpm dev",
    "emulators:build": "pnpm generate && firebase emulators:start --only hosting",
    "emulate": "pnpm generate && firebase emulators:start --only hosting",
    "emulate:studio": "pnpm generate && pnpm build:studio && firebase emulators:start --only hosting,functions"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "1.3.10",
    "@nuxt/ui": "4.11.3",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.1",
    "nuxt-studio": "^1.7.0",
    "sharp": "^0.34.5",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/simple-icons": "^1.2.98",
    "@lhci/cli": "^0.15.1",
    "@nuxt/cli": "^3.37.0",
    "@nuxt/devtools": "latest",
    "@nuxt/eslint-config": "^0.5.7",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "h3": "^1.15.11",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nuxi": "^3.37.0",
    "nuxt": "^4.5.2",
    "pa11y": "^9.1.1",
    "playwright-core": "1.55.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "**/*.{css,scss,md,yml,yaml,json}": [
      "prettier --write"
    ],
    "content/**/*.{md,yml,yaml}": [
      "node scripts/format-content.mjs"
    ],
    "package.json": [
      "bash -c 'pnpm lockfile:check'"
    ]
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "current"
      ],
      "cpu": [
        "x64",
        "current"
      ],
      "libc": [
        "glibc",
        "musl",
        "current"
      ]
    },
    "overrides": {
      "sharp": "^0.35.4",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "@nuxtjs/mdc@<0.22.1": "^0.22.1",
      "uuid@<11.1.1": "^11.1.1",
      "basic-ftp@<=6.2.0": "^6.2.1",
      "mdast-util-to-markdown": "2.1.2"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "chromedriver",
      "esbuild",
      "puppeteer",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [],
    "packageExtensions": {
      "nuxt-studio": {
        "dependencies": {
          "ufo": "^1.6.1"
        }
      }
    }
  },
  "pnpmConfig": {
    "enable-pre-post-scripts": true,
    "auto-install-peers": true
  }
}
